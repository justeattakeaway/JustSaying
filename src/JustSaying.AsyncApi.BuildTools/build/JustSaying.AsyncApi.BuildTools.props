<Project>
  <PropertyGroup>
    <!--
      Set to 'false' to reference the package without generating documents on every build: for
      example in a build that cannot run the application. Generation runs the application's entry
      point up to the point it builds its host, so it is skipped automatically when building for
      a runtime identifier the build machine cannot run, and during 'dotnet publish'.

      Anything generation has to leave out of the document (for example a publication to a
      destination computed per message) is reported as a build warning with a stable code,
      JSAA101 to JSAA107. To keep one out of the warnings, add its code to
      MSBuildWarningsAsMessages (or MSBuildWarningsNotAsErrors when warnings are errors).
    -->
    <JustSayingAsyncApiGenerateDocumentsOnBuild Condition=" '$(JustSayingAsyncApiGenerateDocumentsOnBuild)' == '' ">true</JustSayingAsyncApiGenerateDocumentsOnBuild>
    <!-- The directory the generated documents are written to. A relative path is relative to the project directory. -->
    <JustSayingAsyncApiDocumentsDirectory Condition=" '$(JustSayingAsyncApiDocumentsDirectory)' == '' ">$(MSBuildProjectDirectory)</JustSayingAsyncApiDocumentsDirectory>
    <!--
      The file name (without extension) of the generated document. When several projects share a
      documents directory, give each a unique name — for example '$(MSBuildProjectName)', which
      produces '<ProjectName>.json' per project instead of colliding on 'asyncapi.json'.
    -->
    <JustSayingAsyncApiDocumentFileName Condition=" '$(JustSayingAsyncApiDocumentFileName)' == '' ">asyncapi</JustSayingAsyncApiDocumentFileName>
    <!--
      How long document generation waits for the application's entry point to build its host
      before failing the build. Applications that do slow work before building the host (for
      example migrations or waiting on a dependency) can raise this, or skip that work when
      generating: the entry assembly is 'JustSaying.AsyncApi.GetDocument' during generation.
    -->
    <JustSayingAsyncApiEntryPointTimeoutSeconds Condition=" '$(JustSayingAsyncApiEntryPointTimeoutSeconds)' == '' ">60</JustSayingAsyncApiEntryPointTimeoutSeconds>
    <!--
      The host environment the application's host is built in to generate the documents. It is
      'Production' whatever DOTNET_ENVIRONMENT or ASPNETCORE_ENVIRONMENT the build runs with, so the
      documents do not depend on the machine that builds them. Set it (for example to
      'Development') when configuration the host needs in order to be built is only in that
      environment's settings, such as appsettings.Development.json. Every environment writes the
      same file; to keep documents for several, also vary JustSayingAsyncApiDocumentFileName.
    -->
    <JustSayingAsyncApiEnvironment Condition=" '$(JustSayingAsyncApiEnvironment)' == '' ">Production</JustSayingAsyncApiEnvironment>
    <!--
      Set to 'true' to publish the generated documents with the application. By default they are
      kept out of the publish output, where the Web SDK would otherwise include them as content.
    -->
    <JustSayingAsyncApiCopyDocumentsToPublishDirectory Condition=" '$(JustSayingAsyncApiCopyDocumentsToPublishDirectory)' == '' ">false</JustSayingAsyncApiCopyDocumentsToPublishDirectory>
  </PropertyGroup>
</Project>
